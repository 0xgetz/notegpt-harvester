# Environment overrides (copy to .env and source, or export directly).
# CLI flags take precedence over these values.

NGH_COUNT=5
NGH_CONCURRENCY=3
NGH_LOG_LEVEL=INFO
NGH_RESULTS_DIR=results

# Temporary email provider: mailtm (default) or zenvex
NGH_EMAIL_PROVIDER=mailtm

# 9Router management API
NGH_ROUTER_ENABLED=true
NGH_ROUTER_URL=http://localhost:20128
# NGH_ROUTER_API_KEY=

# Optional outbound proxy
# NGH_PROXY=http://user:pass@host:port

# Optional fixed password (otherwise random per account)
# NGH_NOTEGPT_PASSWORD=
